APP_ADDR=:8080
DATABASE_URL=postgres://restaurant:change-me@localhost:5432/restaurant?sslmode=disable
LOG_LEVEL=info
# Clave HMAC de los JWT: >= 32 bytes, aleatoria y secreta. Generar con: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=service-restaurant
JWT_AUDIENCE=service-restaurant-api
# Puerto del host para la API en docker compose (8080 si esta libre)
API_PORT=8080
