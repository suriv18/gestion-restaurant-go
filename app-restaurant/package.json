{
    "name": "app-restaurant",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:run": "ng test --watch=false",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright show-report",
        "format": "prettier --write src playwright.config.ts e2e",
        "format:check": "prettier --check src playwright.config.ts e2e",
        "lint": "eslint src"
    },
    "private": true,
    "packageManager": "npm@11.14.0",
    "dependencies": {
        "@angular/cdk": "21.2.14",
        "@angular/common": "21.2.25",
        "@angular/compiler": "21.2.25",
        "@angular/core": "21.2.25",
        "@angular/forms": "21.2.25",
        "@angular/platform-browser": "21.2.25",
        "@angular/router": "21.2.25",
        "@fontsource-variable/dm-sans": "5.3.0",
        "@fontsource-variable/manrope": "5.3.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular/build": "21.2.27",
        "@angular/cli": "21.2.27",
        "@angular/compiler-cli": "21.2.25",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/postcss": "4.3.3",
        "angular-eslint": "21.4.0",
        "eslint": "10.13.0",
        "jsdom": "^28.0.0",
        "postcss": "8.5.30",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2",
        "vitest": "^4.0.8"
    },
    "engines": {
        "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
    }
}
