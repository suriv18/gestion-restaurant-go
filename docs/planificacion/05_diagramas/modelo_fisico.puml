  respondido_en : timestamp with time zone
}
entity "auditoria_eventos" as auditoria_eventos {
  * id : bigint
  * tabla : character varying(80)
  * registro_id : bigint
  * accion : character varying(10)
  * usuario_bd : text
  * transaccion : bigint
  datos_antes : jsonb
  datos_despues : jsonb
}
