  emitido_en : timestamp with time zone
  anulado_en : timestamp with time zone
  motivo_anulacion : text
  * clave_idempotencia : uuid
}
entity "comprobante_detalles" as comprobante_detalles {
  * id : bigint
  * comprobante_id : bigint
  * numero_linea : integer
  detalle_pedido_id : bigint
  codigo_producto : character varying(40)
  * descripcion : character varying(250)
  * unidad_sunat : character varying(10)
  * cantidad : numeric(14,3)
  * precio_unitario : numeric(14,6)
  * descuento_total : numeric(14,2)
  * afectacion_igv : character(2)
  * tasa_impuesto : numeric(7,4)
  importe_total : numeric(14,2)
  base_imponible : numeric(14,2)
}
entity "envios_comprobante" as envios_comprobante {
  * id : bigint
  * comprobante_id : bigint
  * numero_intento : integer
  * proveedor : character varying(80)
  id_externo : character varying(150)
